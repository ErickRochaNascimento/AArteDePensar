generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid()) @db.VarChar(30)
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.VarChar(30)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Author {
  id        String   @id @default(cuid()) @db.VarChar(30)
  slug      String   @unique @db.VarChar(120)
  name      String   @db.VarChar(120)
  bio       String   @db.Text
  color     String   @db.VarChar(7)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  books     Book[]

  @@map("authors")
}

model Book {
  id          String   @id @default(cuid()) @db.VarChar(30)
  slug        String   @unique @db.VarChar(160)
  title       String   @db.VarChar(160)
  authorId    String   @db.VarChar(30)
  year        Int
  category    String   @db.VarChar(60)
  pages       Int
  price       Decimal  @db.Decimal(10, 2)
  synopsis    String   @db.Text
  c1          String   @db.VarChar(7)
  c2          String   @db.VarChar(7)
  // Avaliações demonstrativas; as avaliações reais são um item Extra (Entrega 3).
  rating      Decimal  @default(0) @db.Decimal(2, 1)
  reviewCount Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  author      Author   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([published, category])
  @@map("books")
}
