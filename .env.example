# Copie para .env e substitua os marcadores pelos dados do usuário local da livraria.
# Codifique caracteres especiais da senha como URL-encoding (ex.: @ vira %40).
DATABASE_URL="mysql://livraria_app:SENHA_URL_ENCODED@127.0.0.1:3306/livraria?connection_limit=5"

# No computador local em HTTP, mantenha false. Em hospedagem HTTPS, use true.
AUTH_COOKIE_SECURE=false
